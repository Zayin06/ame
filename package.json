{
  "name": "ame-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "build:server": "vite build --config vite.server.config.ts",
    "dev": "npm run runtime:prepare && npm run build:server && electron-vite dev",
    "build": "npm run runtime:prepare && npm run build:server && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 test/*.test.ts packages/amekit/test/*.test.ts packages/amekit-server/test/*.test.ts apps/desktop/src/renderer/test/*.test.ts",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test:terminal": "npm run build && node scripts/smoke-terminal.mjs",
    "test:ui": "node scripts/test-ui-e2e.mjs",
    "bench:desktop": "node scripts/benchmark-desktop.mjs",
    "test:perf": "node --import tsx --test test/ts-lsp.test.ts test/benchmark-packaging.test.ts && node scripts/benchmark-desktop.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && node scripts/build-win-release.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.3.2",
    "@opentunnel/client": "0.6.2",
    "fflate": "0.8.2",
    "node-pty": "1.1.0",
    "simple-git": "3.30.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@opencode/plugin": "2.3.2",
    "@opencode/schema": "2.3.2",
    "@pierre/diffs": "1.6.1",
    "@shikijs/monaco": "4.6.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "github-markdown-css": "5.9.0",
    "jsdom": "26.1.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "tech.ameno.ide",
    "productName": "Ame IDE",
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "out/main/**/*",
      "node_modules/typescript/**/*",
      "node_modules/tsx/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*",
      "node_modules/get-tsconfig/**/*",
      "node_modules/resolve-pkg-maps/**/*"
    ],
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "references/OPENCODE_LICENSE.txt",
      "references/PIERRE_DIFFS_LICENSE.txt",
      "!node_modules/node-pty/build/deps/**",
      "!node_modules/node-pty/build/Release/obj/**",
      "!node_modules/node-pty/build/Release/*.{iobj,ipdb,pdb,lib,exp,tlog}",
      "!node_modules/node-pty/{deps,src,third_party}/**"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/opencode",
        "to": "opencode"
      },
      {
        "from": "resources/amekit-models",
        "to": "amekit-models"
      },
      {
        "from": "packages/amekit/src/assets/ame-chibi.png",
        "to": "ame-chibi.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
